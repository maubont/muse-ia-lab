# Variables del gateway de Musa — SOLO NOMBRES Y PLACEHOLDERS.
#
# Copiar a `.env` (ignorado por git) y rellenar. Nunca commitear el `.env`.
# Generar los secretos con:
#   openssl rand -hex 24     (o en PowerShell: [guid]::NewGuid().ToString('N'))

# ── Gateway (Evolution API) ──────────────────────────────────────────────────
# Clave con la que se autentican TODAS las llamadas REST al gateway.
AUTHENTICATION_API_KEY=<generar-32-bytes-hex>

# Secreto con el que Evolution firma el webhook (JWT HS256, 10 min).
# Con esto el servidor de Musa rechaza cualquier POST que no venga del gateway.
EVOLUTION_JWT_KEY=<generar-32-bytes-hex>

# Contraseña de la base de datos del gateway (no es la base de negocio de Musa).
POSTGRES_PASSWORD=<generar>

# ── Servidor de Musa (lo lee next/src/config.ts) ─────────────────────────────
# URL pública del gateway.
EVOLUTION_URL=https://<servicio>-<proyecto>.up.railway.app

# La misma AUTHENTICATION_API_KEY: es cómo Musa le habla a Evolution.
EVOLUTION_APIKEY=<igual-que-AUTHENTICATION_API_KEY>

# Nombre de la instancia de WhatsApp. Para Musa: musa
EVOLUTION_INSTANCE=musa

# ── Credencial del webhook: UNA de las dos es obligatoria ────────────────────
# Mecanismo 1 — JWT firmado por Evolution (preferido: caduca en 10 min).
# Verificado en el código de `main`; confirmar que la versión desplegada lo emite.
EVOLUTION_JWT_KEY=<mismo-que-EVOLUTION_JWT_KEY-del-gateway>

# Mecanismo 2 — secreto compartido en cabecera estática.
# Es el que funciona con Evolution v2.3.7 sin firmar. Si no hay JWT, hace falta.
EVOLUTION_WEBHOOK_SECRET=<generar-32-bytes-hex>

# Nombre de la cabecera. Por defecto x-evolution-secret.
EVOLUTION_WEBHOOK_HEADER=x-evolution-secret

# ── Reglas ──────────────────────────────────────────────────────────────────
# · Este archivo NUNCA se commitea (`.env` está en .gitignore).
# · Ningún secreto se pega en el chat, en issues ni en logs.
# · El payload del webhook trae `apikey` en claro: no loguear cuerpos crudos.

# --- Alertas del monitor de sesión ---
# Telegram: crea un bot con @BotFather y pon aquí la URL con el token.
#   https://api.telegram.org/bot<TOKEN>/sendMessage
# El chat_id NO es el teléfono: se obtiene escribiéndole al bot y mirando
#   https://api.telegram.org/bot<TOKEN>/getUpdates   ->  result[0].message.chat.id
# También vale Slack (hooks.slack.com), Discord (discord.com/api/webhooks) o
# cualquier webhook genérico (n8n, Make, Zapier).
MUSA_ALERTA_WEBHOOK=
MUSA_ALERTA_CHAT_ID=
# Cada cuánto revisa la sesión (ms). Por defecto 5 minutos.
MUSA_MONITOR_MS=300000

# Dominio público del servidor de Musa (para los enlaces de acceso al curso).
# Sin esto, la entrega manda los enlaces sueltos de Drive en vez del enlace
# personal. Ejemplo: https://server-production-3709.up.railway.app
MUSA_URL_PUBLICA=